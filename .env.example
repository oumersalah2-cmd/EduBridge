PORT=4000
MONGO_URL=mongodb://mongo:27017/edubridge
STUDIO_KEY=change-me-to-a-long-random-string
WHISPER_MODEL=base
MAX_UPLOAD_MB=200
MOCK_API=true
# Base URL used to build absolute links for captions, audio, sign video, braille, embeds, and live sessions.
# When empty, EduBridge dynamically detects reverse proxy headers (X-Forwarded-Proto, X-Forwarded-Host).
# For classroom / LAN hotspot use without internet, set this to your laptop's LAN address (e.g. http://192.168.1.50:4000).
PUBLIC_BASE_URL=http://localhost:4000

# OpenAPI specification location (root openapi.yaml is the single authoritative contract)
OPENAPI_PATH=./openapi.yaml

# Amharic caption generation: "off" (human-first, no auto Amharic track until submitted) or "direct" (Whisper language am draft)
AMHARIC_MODE=off

# Optional secret key for signing outbound webhooks (HMAC SHA-256 header X-EduBridge-Signature)
WEBHOOK_SECRET=

# Set to true only in automated test environments to permit webhooks to private/localhost addresses
WEBHOOK_ALLOW_PRIVATE=false
